# Plantilla de secrets para las Edge Functions.
# Copia a supabase/functions/.env para pruebas locales (ese archivo NO se sube).
# En produccion van como secrets en Supabase: Edge Functions -> Secrets.

# Chat con IA, opcion A: API de Claude directa (si esta definida, se usa esta)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Chat con IA, opcion B: AWS Bedrock (se usa si no hay ANTHROPIC_API_KEY)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Voz (ElevenLabs, opcional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
