# Copia a .env y llena los valores (.env no se sube al repo).
# Son publicos por diseno (van dentro de la app); RLS protege los datos.
# NUNCA pongas aqui la service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Chat: "ia" usa la Edge Function 'chat' (necesita la IA desplegada en Supabase).
# Vacio o cualquier otro valor: modo demo con respuestas preconfiguradas (los montos
# de las propuestas los sigue calculando el planner).
EXPO_PUBLIC_CHAT_MODE=
